DirectoryIndex index.php
Options -Indexes

# ── Force HTTPS ─────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Block known scanner & exploit tools (by User-Agent) ─
RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|zgrab|nuclei|dirbuster|gobuster|wfuzz|hydra|acunetix|nessus|openvas|burpsuite|metasploit|havij|jbrofuzz|skipfish|w3af|arachni|vega|appscan|webinspect|paros|zap|owasp|nessus|retina|nexpose) [NC]
RewriteRule .* - [F,L]

# ── Block common scan/exploit paths (return 404 to not reveal existence)
RewriteRule ^(wp-admin|wp-login\.php|wp-content|xmlrpc\.php|phpmyadmin|pma|mysqladmin|myadmin|adminer|phpinfo\.php|info\.php|test\.php|shell\.php|cmd\.php|eval-stdin\.php|setup\.php|install\.php|config\.php|backup|db_backup|\.git|\.env|\.aws|\.ssh|vendor/|composer\.(json|lock)|package\.json|\.DS_Store|Thumbs\.db|web\.config|readme\.html|license\.txt|wp-config\.php|server-status|server-info)(/|$) [NC,L]
RewriteRule \.(bak|backup|old|orig|save|swp|~)$ - [F,L]

# ── Clean URLs: .php → extensionless (301 redirect, GET only) ─
# RewriteCond guards ensure POST/fetch API calls are NOT redirected
# (301 would silently convert POST→GET, breaking all AJAX endpoints)
# HQ pages
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^hq/(dashboard|outlet|laporan|keuangan|karyawan|mutasi|sdm|penggajian|roles|pelanggan|promo|layanan|droppoint|billing|coin-info|investor|checklist|broadcast|audit|settings|struk|ai-chat|ai-churning|inventori|mesin|loyalty|bonus-rule|export|support)\.php$ /hq/$1 [R=301,L]
# App pages
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^(dashboard|pos|orders|kanban|kas|checklist|laporan|piutang|layanan|promo|customer|loyalty|retention|karyawan|absensi|settings|struk|audit|import|support|login|logout|register|track|landing|tos|privacy|maintenance|demo|accept-tos|deposit|member|approval-inbox|outlet-settings|payment-settings|cek|inventori|mesin|self|produksi|antar-jemput|kurir|kurir-master|p|pelanggan|pelanggan-order)\.php$ /$1 [R=301,L]
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^droppoint_manager\.php$ /droppoint [R=301,L]
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^owner_report\.php$ /owner-report [R=301,L]
# Affiliate pages
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^affiliate/(register|login|dashboard|logout)\.php$ /affiliate/$1 [R=301,L]
# Auth flow & email pages
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^(pending-verify|resend-verify|select-outlet|switch-outlet|no-assignment|account-suspended|outlet-suspended|add-outlet|verify-email|reset-password|demo-exit)\.php$ /$1 [R=301,L]

# ── Clean URLs: extensionless → .php (internal rewrite)
# HQ pages
RewriteRule ^hq/(dashboard|outlet|laporan|keuangan|karyawan|mutasi|sdm|penggajian|roles|pelanggan|promo|layanan|droppoint|billing|coin-info|investor|checklist|broadcast|audit|settings|struk|ai-chat|ai-churning|inventori|mesin|loyalty|bonus-rule|export|support)$ hq/$1.php [L,QSA]
# App pages
RewriteRule ^(dashboard|pos|orders|kanban|kas|checklist|laporan|piutang|layanan|promo|customer|loyalty|retention|karyawan|absensi|settings|struk|audit|import|support|login|logout|register|track|landing|tos|privacy|maintenance|demo|accept-tos|deposit|member|approval-inbox|outlet-settings|payment-settings|cek|inventori|mesin|self|produksi|antar-jemput|kurir|kurir-master|p|pelanggan|pelanggan-order)$ $1.php [L,QSA]
RewriteRule ^droppoint$ droppoint_manager.php [L,QSA]
RewriteRule ^owner-report$ owner_report.php [L,QSA]
# Affiliate pages
RewriteRule ^affiliate/(register|login|dashboard|logout)$ affiliate/$1.php [L,QSA]
RewriteRule ^(pending-verify|resend-verify|select-outlet|switch-outlet|no-assignment|account-suspended|outlet-suspended|add-outlet|verify-email|reset-password|demo-exit)$ $1.php [L,QSA]

# ── Block sensitive file types from web access ──────
<FilesMatch "\.(sql|md|yml|yaml|log|bak|env|ini|conf|sh)$">
  Require all denied
</FilesMatch>

# ── Block dotfiles (.git, .env, .htaccess content) ──
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ── Block sensitive directories entirely ────────────
RedirectMatch 403 ^/storage/
RedirectMatch 403 ^/master/(config|sql)/
RedirectMatch 403 ^/tenant/(migrations|seeds)/
RedirectMatch 403 ^/superadmin/sql/
RedirectMatch 403 ^/superadmin/middleware/
RedirectMatch 403 ^/cron/
RedirectMatch 403 ^/scripts/
RedirectMatch 403 ^/middleware/
RedirectMatch 403 ^/core/

# ── Service Worker scope header ─────────────────────
<Files "sw.js">
  Header set Service-Worker-Allowed "/"
</Files>

# ── Security & anti-fingerprint headers ─────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set X-Permitted-Cross-Domain-Policies "none"
  # Hapus header yang mengungkap teknologi stack
  Header unset X-Powered-By
  Header always unset X-Powered-By
  Header unset Server
</IfModule>

# ── Sembunyikan versi PHP ────────────────────────────
<IfModule mod_php.c>
  php_flag expose_php Off
</IfModule>
<IfModule mod_php8.c>
  php_flag expose_php Off
</IfModule>
